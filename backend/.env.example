# Start locally without any accounts. Both mock AI and local storage are explicit.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. Tried once when GEMINI_MODEL is overloaded (503), out of quota (429),
# or still timing out (timeout or 504) after one retry.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
DATABASE_URL=sqlite:///./data/flatsketch.db
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./data/uploads
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
CORS_ORIGINS=["http://localhost:5173"]
# Required when exposing this shared team demo online. Send X-API-Key on requests.
BACKEND_API_KEY=
MAX_UPLOAD_BYTES=5242880
# Optional AI labels/results folder. Empty uses repository-root/AI.
MONITOR_DATA_DIR=
MONITOR_IMPORT_HISTORY=true
MONITOR_HISTORY_TIMEZONE=America/New_York
# For Tiger replace DATABASE_URL above ONLY in .env, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
